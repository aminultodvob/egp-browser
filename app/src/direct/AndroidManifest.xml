<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Custom Tabs browsers for the PayStation checkout page. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application>
        <!-- Account, trial and purchase. The deep link only triggers an authenticated status check. -->
        <activity
            android:name=".access.AccessActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="payment-result"
                    android:scheme="egpbrowser" />
            </intent-filter>
        </activity>
    </application>
</manifest>
