<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/brand_logo" />

        <LinearLayout
            android:id="@+id/addressPill"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/securityIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/security_not_verified"
                android:src="@drawable/ic_lock"
                app:tint="@color/brand_green_text" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/modeBadge"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mode_chip"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="invisible"
        app:indicatorColor="@color/brand_blue_bright"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/offline_banner"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnErrorContainer"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <include
            android:id="@+id/errorView"
            layout="@layout/view_error"
            android:visibility="gone" />

        <include
            android:id="@+id/lockedView"
            layout="@layout/view_locked"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/popupLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_brand_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/popupTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@android:color/white" />

                <ImageButton
                    android:id="@+id/popupClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/popup_close"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/popupContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/customViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:elevation="12dp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/exitFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:contentDescription="@string/action_exit_fullscreen"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone"
            app:fabSize="mini" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/buttonBack"
                style="@style/Widget.EgpBrowser.ToolbarButton"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                android:id="@+id/buttonForward"
                style="@style/Widget.EgpBrowser.ToolbarButton"
                android:contentDescription="@string/action_forward"
                android:src="@drawable/ic_arrow_forward" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/buttonHome"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_home_button"
                    android:contentDescription="@string/action_home"
                    android:elevation="3dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_home"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/buttonReload"
                style="@style/Widget.EgpBrowser.ToolbarButton"
                android:contentDescription="@string/action_reload"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/buttonMenu"
                style="@style/Widget.EgpBrowser.ToolbarButton"
                android:contentDescription="@string/action_menu"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
