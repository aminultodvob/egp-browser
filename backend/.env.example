# e-GP Browser backend configuration. Copy to .env for local development; in staging/production
# set these as secrets in your hosting provider. NEVER commit real values.
# Generate JWT_SECRET, TRIAL_HASH_SECRET and the entitlement key pair with:  npm run keygen

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Set to true only behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=false

DATABASE_URL=postgres://egp:egp@localhost:5432/egp_browser

# Public HTTPS origin of this API (used to build PayStation's callback_url).
PUBLIC_BASE_URL=https://api.your-domain.example

JWT_SECRET=
TRIAL_HASH_SECRET=
# PKCS#8 PEM on one line with \n escapes (output of npm run keygen).
ENTITLEMENT_PRIVATE_KEY=

# OAuth 2.0 *Web application* client ID used by the Android app as serverClientId
# (Google Cloud Console -> APIs & Services -> Credentials). Comma-separate several if needed.
GOOGLE_CLIENT_IDS=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# PayStation. Sandbox: https://sandbox.paystation.com.bd   Production: https://api.paystation.com.bd
PAYSTATION_BASE_URL=https://sandbox.paystation.com.bd
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
# 0 = merchant pays the gateway charge (keeps the verified amount exactly 250 BDT). Keep 0.
PAYSTATION_PAY_WITH_CHARGE=0

APP_RETURN_URL=egpbrowser://payment-result
MAX_TRIALS_PER_DEVICE=1
