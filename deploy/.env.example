# Copy to deploy/.env on the server (chmod 600). Never commit it.
# Domains must already point (DNS A/AAAA records) to the server's IP before the first start.
API_DOMAIN=api.example.com
SITE_DOMAIN=example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=you@example.com
# Long random password, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=
