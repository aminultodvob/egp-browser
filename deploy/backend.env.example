# Copy to deploy/backend.env on the server (chmod 600). Never commit it.
# DATABASE_URL, PUBLIC_BASE_URL, NODE_ENV, PORT and TRUST_PROXY are set by docker-compose.yml.

# From:  cd backend && npm run keygen   (run on your own computer; keep the output private)
JWT_SECRET=
TRIAL_HASH_SECRET=
ENTITLEMENT_PRIVATE_KEY=

# Google Cloud -> Google Auth Platform -> Clients -> the "Web application" client ID
GOOGLE_CLIENT_IDS=

# PayStation PRODUCTION (merchant panel). For a staging server use https://sandbox.paystation.com.bd
PAYSTATION_BASE_URL=https://api.paystation.com.bd
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_PAY_WITH_CHARGE=0

APP_RETURN_URL=egpbrowser://payment-result
MAX_TRIALS_PER_DEVICE=1
CRON_SECRET=
